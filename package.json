{
  "name": "jonathanthom-com",
  "version": "1.0.0",
  "description": "Personal website for Jonathan Thom",
  "main": "index.html",
  "scripts": {
    "setup": "bun install && bun x playwright install --with-deps chromium",
    "start": "serve",
    "dev": "bun --watch scripts/dev-server.js",
    "test": "bun x playwright test",
    "test:ui": "bun x playwright test --ui",
    "test:headed": "bun x playwright test --headed",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"playwright-report/**,test-results/**\"",
    "lint": "bun run lint:css && bun run lint:html",
    "lint:fix": "stylelint \"**/*.css\" --fix",
    "ci": "bun run lint && bun run test",
    "ci:setup": "bun install --frozen-lockfile && bun x playwright install --with-deps chromium",
    "add-photo": "bun scripts/add-photo.js"
  },
  "packageManager": "bun@1.2.0",
  "keywords": [],
  "author": "Jonathan Thom",
  "license": "ISC",
  "dependencies": {
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "htmlhint": "^1.8.0",
    "sharp": "^0.34.5",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
